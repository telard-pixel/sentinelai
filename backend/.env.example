# Copia questo file in .env e completa i valori. Il .env NON va mai condiviso.
MONGO_URL=mongodb://mongo:27017
DB_NAME=sentinelai
# Password per entrare nell'app (vuota = nessun login: solo per prove).
APP_PASSWORD=
# Token del bot Telegram per gli allarmi (da @BotFather). Vuoto = Telegram spento.
TELEGRAM_BOT_TOKEN=
# Login con Google (facoltativo): client OAuth "Applicazione web" con URI di reindirizzamento
# https://<indirizzo dell'app>/api/auth/google/callback, e gli indirizzi Gmail ammessi separati da virgole.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAILS=
# Solo se il frontend sta su un ALTRO indirizzo: elenco separato da virgole (mai "*").
CORS_ORIGINS=
# Nomi con cui si apre l'app (es. 192.168.0.50,sentinel.taile84bd0.ts.net). Vuoto = qualsiasi.
ALLOWED_HOSTS=
# Indirizzi da cui si apre l'app se diversi dal nome del server (di solito non serve), es. https://sentinel.taile84bd0.ts.net
ALLOWED_ORIGINS=
DATA_DIR=/data
