[Unit]
Description=SentinelAI (telecamere, YOLO11s)
After=network-online.target
Wants=network-online.target

[Service]
User=sentinelai
Group=sentinelai
WorkingDirectory=/opt/sentinelai
Environment=SENTINEL_DATI=/var/lib/SentinelAI
Environment=SENTINEL_PORTA=8765
Environment=TZ=Europe/Rome
# OpenCV: un thread per core di default; lasciamo un core libero al resto del CT
Environment=OMP_NUM_THREADS=3
# 1.0.12: pulsante "Aggiorna": la richiesta la esegue sentinelai-aggiorna (root, linux/aggiorna.sh)
Environment=SENTINEL_AGGIORNAMENTO=linux
ExecStart=/opt/sentinelai/venv/bin/python /opt/sentinelai/linux/sentinel_server.py
Restart=always
# 1.0.9: file nuovi (database, registro, clip) leggibili solo dal servizio
UMask=0077
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/SentinelAI /mnt
# 1.0.14: niente più PrivateDevices, perché l'IA (OpenVINO) deve aprire la scheda video Intel /dev/dri/renderD128.
# DevicePolicy/DeviceAllow chiudono gli altri dispositivi su una macchina vera, ma DENTRO UN CT LXC systemd non li
# applica (agente 112: /dev/urandom si apriva lo stesso): lì valgono solo i permessi dei file (console/tty root 600/620).
# Il gruppo render c'è in ogni Debian; senza scheda video (o senza intel-opencl-icd) l'IA va sul processore.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/dri/renderD128 rw
SupplementaryGroups=render
# 1.0.9 (revisione di configurazione): difese in più che non toccano rete, telecamere e /var/lib/SentinelAI
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# AF_NETLINK serve a "ip -4 addr" (nomi ammessi)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
