# 1.0.12: il pulsante "Aggiorna" dell'app crea questo file; systemd avvia sentinelai-aggiorna (root).
[Unit]
Description=SentinelAI: richiesta di aggiornamento dall'app

[Path]
PathExists=/var/lib/SentinelAI/aggiornamento/richiesta
Unit=sentinelai-aggiorna.service

[Install]
WantedBy=multi-user.target
